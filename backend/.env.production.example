APP_NAME=CareMatch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://carematch.example.com
FRONTEND_URL=https://carematch.example.com
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=carematch
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=carematch_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=carematch.example.com

CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
CANDIDATE_DOCUMENTS_DISK=candidate_documents_s3
AWS_DEFAULT_REGION=
AWS_CANDIDATE_DOCUMENTS_BUCKET=
AWS_CANDIDATE_DOCUMENTS_PREFIX=candidate-documents

# Email-triggering routes are disabled while public demo mode is enabled.
# Configure a real production mail transport before disabling public demo mode.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=CareMatch

CARE_MATCH_PUBLIC_DEMO=true
CARE_MATCH_DEMO_DATA=false
CARE_MATCH_DEMO_EMAIL=demo.admin@example.test
CARE_MATCH_DEMO_PASSWORD=
