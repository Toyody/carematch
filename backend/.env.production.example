APP_NAME=CareMatch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://carematch.example.com
COMPLIANCE_EXPIRY_WARNING_DAYS=30
CARE_MATCH_AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_QUEUE=ai
AI_MAX_RECEIVE_COUNT=3
AI_CONNECT_TIMEOUT_SECONDS=10
AI_TIMEOUT_SECONDS=90
# OPENAI_API_KEY is injected from Secrets Manager only when AI is explicitly enabled.
FRONTEND_URL=https://carematch.example.com
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=carematch
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=carematch_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=carematch.example.com

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SCHEME=tls
QUEUE_CONNECTION=sqs
QUEUE_FAILED_DRIVER=null
SQS_PREFIX=
SQS_QUEUE=compliance
AWS_DEFAULT_REGION=
COMPLIANCE_EXPIRY_DIGEST_QUEUE=compliance
COMPLIANCE_EXPIRY_DIGEST_MAX_RECEIVE_COUNT=3

FILESYSTEM_DISK=local
CANDIDATE_DOCUMENTS_DISK=candidate_documents_s3
AWS_DEFAULT_REGION=
AWS_CANDIDATE_DOCUMENTS_BUCKET=
AWS_CANDIDATE_DOCUMENTS_PREFIX=candidate-documents
# Leave unset for AWS S3. These are test-only compatibility overrides.
AWS_CANDIDATE_DOCUMENTS_ENDPOINT=
AWS_CANDIDATE_DOCUMENTS_USE_PATH_STYLE_ENDPOINT=false
AWS_CANDIDATE_DOCUMENTS_CONNECT_TIMEOUT=5
AWS_CANDIDATE_DOCUMENTS_TIMEOUT=30

# Email-triggering routes are disabled while public demo mode is enabled.
# Configure a real production mail transport before disabling public demo mode.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=CareMatch

CARE_MATCH_PUBLIC_DEMO=true
CARE_MATCH_DEMO_DATA=false
CARE_MATCH_DEMO_EMAIL=demo.admin@example.test
CARE_MATCH_DEMO_PASSWORD=
