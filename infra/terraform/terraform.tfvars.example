aws_region                  = "ap-southeast-2"
environment                 = "production"
acm_certificate_arn         = "arn:aws:acm:ap-southeast-2:123456789012:certificate/example"
application_url             = "https://carematch.example.com"
app_key_secret_arn          = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:carematch-app-key"
redis_auth_token            = "replace-through-secure-operator-input"
redis_auth_token_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:carematch-redis-auth"
mail_from_address           = "noreply@example.com"
mail_host                   = "smtp.example.com"
mail_username               = "carematch-production"
mail_password_secret_arn    = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:carematch-smtp-password"
github_repository           = "example/carematch"
github_oidc_provider_arn    = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
backend_image               = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/carematch-production-backend:bootstrap"
frontend_image              = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/carematch-production-frontend:bootstrap"
care_match_public_demo      = true
